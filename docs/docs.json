{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Deepdub Documentation",
  "colors": {
    "primary": "#FF3390",
    "light": "#FF3390",
    "dark": "#FF3390"
  },
  "logo": {
    "light": "/logo/logo128.png",
    "dark": "/logo/logo128.png"
  },
  "favicon": "/favicon.svg",
  "seo": {
    "metatags": {
      "title": "Deepdub Docs | Voice AI APIs, SDKs, and Developer Guides",
      "description": "The developer hub for Deepdub voice AI. Explore documentation, SDKs, and API references for integrating expressive multilingual voice and AI dubbing into your workflows."
    }
  },
  "openapi": "openapi3.json",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": ["introduction", "quickstart", "authentication", "voice-presets"]
          },
          {
            "group": "SDKs",
            "pages": ["sdk", "sdk-javascript"]
          },
          {
            "group": "AI Agent Integration",
            "pages": ["cursor-skill", "claude-code"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "TTS",
            "pages": [
              "api-reference/tts/generate-and-stream-tts-audio"
            ]
          },
          {
            "group": "WebSocket",
            "pages": [
              "api-reference/websocket/overview",
              "api-reference/websocket/streaming"
            ]
          },
          {
            "group": "Gender Detection",
            "pages": [
              "api-reference/gender-detection/classify-speaker-gender",
              "api-reference/gender-detection/classify-speaker-gender-file-upload"
            ]
          },
          {
            "group": "Voice",
            "pages": [
              "api-reference/voice/get-voice-prompts",
              "api-reference/voice/upload-a-voice-sample",
              "api-reference/voice/update-a-voice-prompt",
              "api-reference/voice/get-a-voice-prompt-by-id",
              "api-reference/voice/delete-a-voice-prompt"
            ]
          },
          {
            "group": "Issues",
            "pages": [
              "api-reference/issues/create-issue",
              "api-reference/issues/list-issues",
              "api-reference/issues/get-issue",
              "api-reference/issues/update-issue",
              "api-reference/issues/update-issue-state",
              "api-reference/issues/delete-issue"
            ]
          },
          {
            "group": "Infrastructure",
            "pages": [
              "api-reference/infrastructure/get-connections-for-multiple-models",
              "api-reference/infrastructure/get-connections-for-a-model",
              "api-reference/infrastructure/update-model-autoscaling-group"
            ]
          },
          {
            "group": "Usage",
            "pages": [
              "api-reference/usage/get-daily-concurrent-usage",
              "api-reference/usage/get-usage-aggregated-by-model"
            ]
          },
          {
            "group": "Live Streaming (Beta)",
            "pages": ["api-reference/live/overview"]
          }
        ]
      },
      {
        "tab": "Managed Dub API",
        "groups": [
          {
            "group": "API Reference",
            "openapi": "managed-dub.openapi.json",
            "pages": [
              "POST /dubbing/job",
              "GET /dubbing/job/{request_id}",
              "GET /dubbing/jobs",
              "PUT /dubbing/job/{request_id}",
              "POST /dubbing/job/{request_id}/sources",
              "PATCH /dubbing/job/{request_id}",
              "DELETE /dubbing/job/{request_id}",
              "POST /provenance/verify"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "managed-dub/subtitle-only-flow",
              "managed-dub/content-credentials"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@deepdub.ai"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/deepdub-ai",
      "website": "https://deepdub.com",
      "linkedin": "https://www.linkedin.com/company/deepdub"
    }
  },
  "api": {
    "auth": {
      "method": "key",
      "name": "x-api-key",
      "defaultValue": "dd-00000000000000000000000065c9cbfe"
    },
    "baseUrl": "https://restapi.deepdub.ai/api/v1",
    "examples": {
      "prefill": true,
      "defaults": "required"
    }
  }
}
